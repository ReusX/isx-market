<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 · three items (dollar / 21K gold / ISX60 by default), identity v3:
     brand row, then three figures each under a hairline with its world's
     square tag and its percent change. RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/widget_bg"
    android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_star" android:layout_width="14dp" android:layout_height="14dp"
            android:src="@drawable/ic_stat_iqwealth" android:contentDescription="@null" />
        <TextView android:id="@+id/w_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:text="@string/app_name" android:textColor="#E9E7E3"
            android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:gravity="end" android:text="@string/w_loading"
            android:textColor="#9BA1AB" android:textSize="10.5sp" android:maxLines="1" />
        <ImageView android:id="@+id/w_cfg" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp"
            android:layout_marginStart="4dp" android:src="@drawable/ic_w_gear" android:alpha="0.6" android:contentDescription="@string/w_settings" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp" android:layout_marginEnd="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/w_c1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:background="@drawable/widget_cell"
            android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/w_t1" android:layout_width="8dp" android:layout_height="8dp"
                    android:src="@drawable/widget_tag" android:contentDescription="@null" />
                <TextView android:id="@+id/w_l1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:textColor="#B9BEC6" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/w_v1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical|start" android:text="—" android:textColor="#E9E7E3" android:textSize="24sp"
                android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="24sp" />
            <TextView android:id="@+id/w_s1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9BA1AB" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textStyle="bold"
                android:textDirection="anyRtl" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp"
            android:orientation="vertical" android:background="@drawable/widget_cell"
            android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/w_t2" android:layout_width="8dp" android:layout_height="8dp"
                    android:src="@drawable/widget_tag" android:contentDescription="@null" />
                <TextView android:id="@+id/w_l2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:textColor="#B9BEC6" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/w_v2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical|start" android:text="—" android:textColor="#E9E7E3" android:textSize="24sp"
                android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="24sp" />
            <TextView android:id="@+id/w_s2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9BA1AB" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textStyle="bold"
                android:textDirection="anyRtl" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="12dp"
            android:orientation="vertical" android:background="@drawable/widget_cell"
            android:paddingStart="2dp" android:paddingEnd="2dp" android:paddingTop="10dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/w_t3" android:layout_width="8dp" android:layout_height="8dp"
                    android:src="@drawable/widget_tag" android:contentDescription="@null" />
                <TextView android:id="@+id/w_l3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:textColor="#B9BEC6" android:textSize="12sp" android:fontFamily="sans-serif-medium"
                    android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/w_v3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:gravity="center_vertical|start" android:text="—" android:textColor="#E9E7E3" android:textSize="24sp"
                android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="12sp" android:autoSizeMaxTextSize="24sp" />
            <TextView android:id="@+id/w_s3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#9BA1AB" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textStyle="bold"
                android:textDirection="anyRtl" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
