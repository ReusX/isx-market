<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 · one item (the dollar by default). RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/widget_bg"
    android:paddingStart="16dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/w_dollar_short" android:textColor="#FFFFFF" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/w_cfg" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp"
            android:src="@drawable/ic_w_gear" android:alpha="0.75" android:contentDescription="@string/w_settings" />
    </LinearLayout>
    <TextView android:id="@+id/w_unit" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B3FFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />

    <TextView android:id="@+id/w_value" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="bottom|start" android:text="—" android:textColor="#FFFFFF" android:textSize="42sp"
        android:fontFamily="sans-serif-light" android:maxLines="1" android:includeFontPadding="false"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="42sp" />

    <TextView android:id="@+id/w_chg" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#CCFFFFFF" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:text="@string/w_loading" android:textColor="#8CFFFFFF" android:textSize="10.5sp" android:maxLines="1" />
</LinearLayout>
