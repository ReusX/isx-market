<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 · one item (the dollar by default), identity v3: the section's square
     tag, the figure with the board's swoosh, the unit, the percent chip.
     RemoteViews-safe views only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:layoutDirection="rtl" android:background="@drawable/widget_bg"
    android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="12dp" android:paddingBottom="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_tag" android:layout_width="10dp" android:layout_height="10dp"
            android:src="@drawable/widget_tag" android:contentDescription="@null" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="@string/w_dollar_short" android:textColor="#E9E7E3" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <ImageView android:id="@+id/w_cfg" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp"
            android:src="@drawable/ic_w_gear" android:alpha="0.6" android:contentDescription="@string/w_settings" />
    </LinearLayout>

    <TextView android:id="@+id/w_value" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="bottom|start" android:text="—" android:textColor="#E9E7E3" android:textSize="44sp"
        android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="20sp" android:autoSizeMaxTextSize="44sp" />
    <ImageView android:id="@+id/w_swoosh" android:layout_width="72dp" android:layout_height="10dp" android:layout_marginTop="2dp"
        android:layout_gravity="start" android:src="@drawable/widget_swoosh" android:scaleType="fitXY" android:contentDescription="@null" />

    <TextView android:id="@+id/w_unit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="#9BA1AB" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_chg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_chip" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:layout_marginEnd="8dp" android:textDirection="ltr" android:textColor="#5CC488" android:textSize="12sp"
            android:fontFamily="sans-serif-medium" android:textStyle="bold" android:maxLines="1" />
        <TextView android:id="@+id/w_time" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/w_loading" android:textColor="#9BA1AB" android:textSize="10.5sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
