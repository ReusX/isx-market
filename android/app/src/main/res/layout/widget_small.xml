<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 · the dollar: source, the rate, the $100 note, when. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg" android:padding="14dp">
    <TextView android:id="@+id/w_label" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/w_dollar" android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/w_fx" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="—" android:textColor="#FFFFFF" android:textSize="34sp" android:fontFamily="sans-serif-light"
        android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" />
    <TextView android:id="@+id/w_fx_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="@string/w_loading" android:textColor="#99FFFFFF" android:textSize="11sp" android:maxLines="1" />
</LinearLayout>
