<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the phone in a cloud backup or a device-to-device
     transfer. The WebView's storage holds the Supabase sign-in session, and
     the widget settings are cheap to redo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
