{
  "name": "isx-market",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check:tokens": "node scripts/token-parity.mjs && node scripts/contrast.mjs && node scripts/arabic-tracking.mjs",
    "build:log": "NEXT_DIST_DIR=.next-check next build > .next-build.log 2>&1 || (cat .next-build.log; exit 1)",
    "check:routes": "npm run build:log && node scripts/route-markers.mjs .next-build.log",
    "check:routes:update": "npm run build:log && node scripts/route-markers.mjs .next-build.log --update",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "check:i18n": "node scripts/i18n-seo.mjs && node scripts/i18n-strings.mjs && node scripts/i18n-qa.mjs && node scripts/i18n-detail.mjs && node scripts/i18n-links.mjs && node scripts/i18n-regress.mjs",
    "audit:depository": "npx tsx scripts/depository-audit.ts",
    "check:secrets": "node scripts/secret-scan.mjs --self-test && node scripts/secret-scan.mjs",
    "check:fx": "npx tsx scripts/fx-parser-test.ts",
    "check:fx-writes": "npx tsx scripts/fx-verify.ts",
    "check:banking": "npx tsx scripts/banking-gates.ts",
    "check:charts": "node scripts/chart-freshness.mjs --self-test && node scripts/chart-freshness.mjs",
    "check:db-perms": "node scripts/db-permissions.mjs",
    "import:editorial": "node scripts/import-bank-editorial.mjs",
    "check:editorial": "node scripts/import-bank-editorial.mjs --check && node scripts/import-bank-editorial.mjs && git diff --quiet -- content/banks/profiles.ar.json",
    "check:charts:static": "node scripts/chart-freshness.mjs --self-test && node scripts/chart-freshness.mjs --static-only",
    "seed:banks": "npx tsx scripts/seed-banks.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@vercel/analytics": "^1.3.1",
    "clsx": "^2.1.1",
    "marked": "^15.0.12",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10",
    "eslint": "^8",
    "eslint-config-next": "15.5.26",
    "postcss": "^8",
    "tailwindcss": "^3.4.14",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  }
}
