{
  "crons": [
    {
      "path": "/api/cron/daily-prices",
      "schedule": "0 11-19/2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.iraqsm.com" }],
      "destination": "https://iraqsm.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=1800, stale-while-revalidate=3600" }
      ]
    }
  ]
}
